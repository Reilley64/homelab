#!/bin/bash
set -euo pipefail

staging={{ backups_staging_dir }}
metrics={{ backups_textfile_dir }}/homelab_backup.prom

# Databases are dumped first; their live files are excluded below because a
# file-by-file copy of a database that is being written is not consistent.
rm -f "$staging"/postgres/* "$staging"/sqlite/*
docker exec {{ backups_postgres_container }} sh -c 'pg_dumpall -U "$POSTGRES_USER" --globals-only' >"$staging/postgres/globals.sql"
for db in $(docker exec {{ backups_postgres_container }} sh -c 'psql -U "$POSTGRES_USER" -d postgres -Atc "select datname from pg_database where not datistemplate and datname <> '"'"'postgres'"'"'"'); do
  docker exec {{ backups_postgres_container }} sh -c "pg_dump -U \"\$POSTGRES_USER\" -Fc \"$db\"" >"$staging/postgres/$db.dump"
done
{% for db in backups_sqlite_databases %}
sqlite3 -cmd '.timeout 30000' '{{ db.path }}' ".backup '$staging/sqlite/{{ db.name }}.db'"
{% endfor %}

excludes=(
{% for path in backups_excludes %}
  --exclude '{{ path }}'
{% endfor %}
)

backup_to() {
  # errexit does not apply inside `||` lists, so every step returns on failure.
  export RESTIC_REPOSITORY=$2
  restic cat config >/dev/null 2>&1 || restic init || return 1
  restic backup --quiet --tag nightly "${excludes[@]}" {{ backups_paths | join(' ') }} || return 1
  restic forget --quiet --prune {{ backups_retention }} || return 1
  if [ "$(date +%u)" = 7 ]; then
    restic check --quiet || return 1
  fi
  printf 'homelab_backup_last_success_timestamp_seconds{repository="%s"} %s\n' "$1" "$(date +%s)" >"$metrics.$1"
}

# Each repository is tried even if another fails; a stale timestamp raises the alert.
failed=0
{% for repo in backups_repositories %}
(backup_to '{{ repo.name }}' '{{ repo.url }}') || failed=1
{% endfor %}

cat "$metrics".* >"$metrics.tmp" 2>/dev/null && mv "$metrics.tmp" "$metrics" && chmod 0644 "$metrics"
exit "$failed"

datacenter = "{{ consul_datacenter }}"
domain     = "{{ consul_domain }}"
node_name  = "{{ inventory_hostname }}"
data_dir   = "{{ consul_data_dir }}"

server           = true
bootstrap_expect = 1

bind_addr      = "{{ consul_address }}"
advertise_addr = "{{ consul_address }}"
client_addr    = "127.0.0.1 {{ consul_address }}"

addresses {
  dns = "127.0.0.1"
}

ports {
  http     = -1
  https    = 8501
  grpc     = -1
  grpc_tls = 8503
  dns      = 8600
  server   = 8300
  serf_lan = 8301
  serf_wan = -1
}

ui_config {
  enabled = true
}

connect {
  enabled = false
}

acl {
  enabled                  = true
  default_policy           = "deny"
  enable_token_persistence = true
}

tls {
  defaults {
    ca_file   = "{{ consul_config_dir }}/tls/ca.crt"
    cert_file = "{{ consul_config_dir }}/tls/agent.crt"
    key_file  = "{{ consul_config_dir }}/tls/agent.key"

    # Browsers, the CLI, Traefik and Prometheus connect without client certificates.
    verify_incoming = false
    verify_outgoing = true
  }

  internal_rpc {
    verify_incoming        = true
    verify_server_hostname = true
  }
}

telemetry {
  prometheus_retention_time = "60s"
  disable_hostname          = true
}

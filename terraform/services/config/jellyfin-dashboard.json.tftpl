{
  "uid": "jellyfin",
  "title": "Public Services",
  "tags": ["homelab", "public-services", "jellyfin", "traefik"],
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Continuous service uptime",
      "description": "Elapsed time since the latest failed in-network HTTPS probe, or the earliest retained probe when no failure exists in the past 30 days.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": { "text": "Unknown", "color": "gray" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox\"} * (time() - (max_over_time(timestamp(probe_success{job=\"blackbox\"} == 0)[30d:]) or min_over_time(timestamp(probe_success{job=\"blackbox\"})[30d:])))",
          "instant": true,
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Availability history",
      "description": "Probe state over the selected dashboard time range.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" },
                "1": { "text": "Up", "color": "green" }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox\"}",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Public route response latency",
      "description": "Total time for DNS, connection, TLS, redirects, and the final HTTP response.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox\"}",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Jellyfin details",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Public response accounting rate",
      "description": "Completed public-router response bytes accounted over time; not physical WAN-interface throughput and may include public-hostname hairpin traffic.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[$__rate_interval])) * 8",
          "legendFormat": "public"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Public egress",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Egress by user",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 26 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Egress" },
            "properties": [{ "id": "unit", "value": "decbytes" }]
          }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "user": 0, "Value": 1 },
            "renameByName": { "user": "User", "Value": "Egress" }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "Egress", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (user) (increase(jellyfin_user_egress_bytes_v2_total[$__range])))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "marcusolsson-dynamictext-panel",
      "title": "p95 latency",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "afterRender": "const root = context.element.querySelector('.jf-latency-card');\nif (!root) { return; }\nconst valueElement = root.querySelector('.jf-latency-value');\nconst qualityElement = root.querySelector('.jf-latency-quality');\nconst raw = context.data?.Value;\nconst seconds = typeof raw === 'number' ? raw : Number.NaN;\nif (!Number.isFinite(seconds)) {\n  delete root.dataset.quality;\n  root.style.setProperty('--latency-position', '0%');\n  valueElement.textContent = 'No data';\n  qualityElement.textContent = '';\n  return;\n}\nconst quality = seconds < 1 ? 'good' : seconds < 2 ? 'warning' : 'poor';\nconst label = quality === 'good' ? 'Good' : quality === 'warning' ? 'Needs improvement' : 'Poor';\nconst decimals = seconds < 10 ? 2 : 1;\nconst precision = 10 ** decimals;\nconst truncatedSeconds = Math.trunc(seconds * precision) / precision;\nconst display = seconds < 1 ? `$${Math.trunc(seconds * 1000)} ms` : `$${truncatedSeconds.toFixed(decimals)} s`;\nconst position = Math.min(3, Math.max(0, seconds)) / 3 * 100;\nroot.dataset.quality = quality;\nroot.style.setProperty('--latency-position', `$${position}%`);\nvalueElement.textContent = display;\nqualityElement.textContent = `($${label})`;",
        "content": "<div class=\"jf-latency-card\"><div class=\"jf-latency-reading\"><span class=\"jf-latency-value\">No data</span><span class=\"jf-latency-quality\"></span></div><div class=\"jf-latency-meter\"><span class=\"jf-latency-meter__pointer\"></span><div class=\"jf-latency-meter__track\"><span class=\"jf-latency-zone jf-latency-zone--good\"></span><span class=\"jf-latency-zone jf-latency-zone--warning\"></span><span class=\"jf-latency-zone jf-latency-zone--poor\"></span></div><span class=\"jf-latency-tick jf-latency-tick--one\"><i></i><b>1 s</b></span><span class=\"jf-latency-tick jf-latency-tick--two\"><i></i><b>2 s</b></span></div></div>",
        "defaultContent": "<div class=\"jf-latency-card jf-latency-card--empty\"><div class=\"jf-latency-reading\"><span class=\"jf-latency-value\">No data</span><span class=\"jf-latency-quality\"></span></div><div class=\"jf-latency-meter\"><span class=\"jf-latency-meter__pointer\"></span><div class=\"jf-latency-meter__track\"><span class=\"jf-latency-zone jf-latency-zone--good\"></span><span class=\"jf-latency-zone jf-latency-zone--warning\"></span><span class=\"jf-latency-zone jf-latency-zone--poor\"></span></div><span class=\"jf-latency-tick jf-latency-tick--one\"><i></i><b>1 s</b></span><span class=\"jf-latency-tick jf-latency-tick--two\"><i></i><b>2 s</b></span></div></div>",
        "editor": { "format": "auto", "language": "html" },
        "editors": ["afterRender", "styles"],
        "renderMode": "everyRow",
        "externalStyles": [],
        "contentPartials": [],
        "helpers": "",
        "status": "",
        "styles": ".jf-latency-card { --good: rgb(115, 191, 105); --warning: rgb(255, 152, 48); --poor: rgb(242, 73, 92); --neutral-zone: rgba(204, 204, 220, 0.16); --pointer: rgb(204, 204, 220); --status-color: currentColor; --latency-position: 0%; box-sizing: border-box; display: flex; flex-direction: column; height: 100%; justify-content: flex-start; padding: 6px 8px 8px; }\n.jf-latency-card[data-quality=\"good\"] { --status-color: var(--good); }\n.jf-latency-card[data-quality=\"warning\"] { --status-color: var(--warning); }\n.jf-latency-card[data-quality=\"poor\"] { --status-color: var(--poor); }\n.jf-latency-card[data-quality=\"good\"] .jf-latency-zone--good { background: var(--good); }\n.jf-latency-card[data-quality=\"warning\"] .jf-latency-zone--warning { background: var(--warning); }\n.jf-latency-card[data-quality=\"poor\"] .jf-latency-zone--poor { background: var(--poor); }\n.jf-latency-card--empty { opacity: 0.7; }\n.jf-latency-reading { color: var(--status-color); font-size: 20px; font-weight: 600; line-height: 1.2; margin-bottom: 6px; white-space: nowrap; }\n.jf-latency-quality { font-size: 13px; font-weight: 400; margin-left: 0.25em; }\n.jf-latency-meter { height: 34px; position: relative; }\n.jf-latency-meter__track { display: flex; height: 8px; left: 0; overflow: hidden; position: absolute; right: 0; top: 7px; }\n.jf-latency-zone { background: var(--neutral-zone); flex: 1 1 33.333333%; height: 100%; }\n.jf-latency-meter__pointer { border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 7px solid var(--pointer); left: var(--latency-position); position: absolute; top: 0; transform: translateX(-50%); z-index: 1; }\n.jf-latency-tick { color: currentColor; font-size: 11px; position: absolute; top: 7px; transform: translateX(-50%); }\n.jf-latency-tick i { background: currentColor; display: block; height: 11px; margin: 0 auto 2px; opacity: 0.75; width: 1px; }\n.jf-latency-tick b { font-weight: 400; white-space: nowrap; }\n.jf-latency-tick--one { left: 33.333333%; }\n.jf-latency-tick--two { left: 66.666667%; }",
        "wrap": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "marcusolsson-dynamictext-panel",
      "title": "p99 latency",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "afterRender": "const root = context.element.querySelector('.jf-latency-card');\nif (!root) { return; }\nconst valueElement = root.querySelector('.jf-latency-value');\nconst qualityElement = root.querySelector('.jf-latency-quality');\nconst raw = context.data?.Value;\nconst seconds = typeof raw === 'number' ? raw : Number.NaN;\nif (!Number.isFinite(seconds)) {\n  delete root.dataset.quality;\n  root.style.setProperty('--latency-position', '0%');\n  valueElement.textContent = 'No data';\n  qualityElement.textContent = '';\n  return;\n}\nconst quality = seconds < 1 ? 'good' : seconds < 2 ? 'warning' : 'poor';\nconst label = quality === 'good' ? 'Good' : quality === 'warning' ? 'Needs improvement' : 'Poor';\nconst decimals = seconds < 10 ? 2 : 1;\nconst precision = 10 ** decimals;\nconst truncatedSeconds = Math.trunc(seconds * precision) / precision;\nconst display = seconds < 1 ? `$${Math.trunc(seconds * 1000)} ms` : `$${truncatedSeconds.toFixed(decimals)} s`;\nconst position = Math.min(3, Math.max(0, seconds)) / 3 * 100;\nroot.dataset.quality = quality;\nroot.style.setProperty('--latency-position', `$${position}%`);\nvalueElement.textContent = display;\nqualityElement.textContent = `($${label})`;",
        "content": "<div class=\"jf-latency-card\"><div class=\"jf-latency-reading\"><span class=\"jf-latency-value\">No data</span><span class=\"jf-latency-quality\"></span></div><div class=\"jf-latency-meter\"><span class=\"jf-latency-meter__pointer\"></span><div class=\"jf-latency-meter__track\"><span class=\"jf-latency-zone jf-latency-zone--good\"></span><span class=\"jf-latency-zone jf-latency-zone--warning\"></span><span class=\"jf-latency-zone jf-latency-zone--poor\"></span></div><span class=\"jf-latency-tick jf-latency-tick--one\"><i></i><b>1 s</b></span><span class=\"jf-latency-tick jf-latency-tick--two\"><i></i><b>2 s</b></span></div></div>",
        "defaultContent": "<div class=\"jf-latency-card jf-latency-card--empty\"><div class=\"jf-latency-reading\"><span class=\"jf-latency-value\">No data</span><span class=\"jf-latency-quality\"></span></div><div class=\"jf-latency-meter\"><span class=\"jf-latency-meter__pointer\"></span><div class=\"jf-latency-meter__track\"><span class=\"jf-latency-zone jf-latency-zone--good\"></span><span class=\"jf-latency-zone jf-latency-zone--warning\"></span><span class=\"jf-latency-zone jf-latency-zone--poor\"></span></div><span class=\"jf-latency-tick jf-latency-tick--one\"><i></i><b>1 s</b></span><span class=\"jf-latency-tick jf-latency-tick--two\"><i></i><b>2 s</b></span></div></div>",
        "editor": { "format": "auto", "language": "html" },
        "editors": ["afterRender", "styles"],
        "renderMode": "everyRow",
        "externalStyles": [],
        "contentPartials": [],
        "helpers": "",
        "status": "",
        "styles": ".jf-latency-card { --good: rgb(115, 191, 105); --warning: rgb(255, 152, 48); --poor: rgb(242, 73, 92); --neutral-zone: rgba(204, 204, 220, 0.16); --pointer: rgb(204, 204, 220); --status-color: currentColor; --latency-position: 0%; box-sizing: border-box; display: flex; flex-direction: column; height: 100%; justify-content: flex-start; padding: 6px 8px 8px; }\n.jf-latency-card[data-quality=\"good\"] { --status-color: var(--good); }\n.jf-latency-card[data-quality=\"warning\"] { --status-color: var(--warning); }\n.jf-latency-card[data-quality=\"poor\"] { --status-color: var(--poor); }\n.jf-latency-card[data-quality=\"good\"] .jf-latency-zone--good { background: var(--good); }\n.jf-latency-card[data-quality=\"warning\"] .jf-latency-zone--warning { background: var(--warning); }\n.jf-latency-card[data-quality=\"poor\"] .jf-latency-zone--poor { background: var(--poor); }\n.jf-latency-card--empty { opacity: 0.7; }\n.jf-latency-reading { color: var(--status-color); font-size: 20px; font-weight: 600; line-height: 1.2; margin-bottom: 6px; white-space: nowrap; }\n.jf-latency-quality { font-size: 13px; font-weight: 400; margin-left: 0.25em; }\n.jf-latency-meter { height: 34px; position: relative; }\n.jf-latency-meter__track { display: flex; height: 8px; left: 0; overflow: hidden; position: absolute; right: 0; top: 7px; }\n.jf-latency-zone { background: var(--neutral-zone); flex: 1 1 33.333333%; height: 100%; }\n.jf-latency-meter__pointer { border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 7px solid var(--pointer); left: var(--latency-position); position: absolute; top: 0; transform: translateX(-50%); z-index: 1; }\n.jf-latency-tick { color: currentColor; font-size: 11px; position: absolute; top: 7px; transform: translateX(-50%); }\n.jf-latency-tick i { background: currentColor; display: block; height: 11px; margin: 0 auto 2px; opacity: 0.75; width: 1px; }\n.jf-latency-tick b { font-weight: 400; white-space: nowrap; }\n.jf-latency-tick--one { left: 33.333333%; }\n.jf-latency-tick--two { left: 66.666667%; }",
        "wrap": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate, public vs LAN",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router) (rate(traefik_router_requests_total{router=~\"jellyfin(local)?@docker\"}[$__rate_interval]))",
          "legendFormat": "{{router}}"
        }
      ]
    }
  ]
}

global:
  scrape_interval: 15s

scrape_configs:
  # Every Nomad service tagged metrics, labelled with its Consul service name.
  # Consul's HTTPS API is on the LAN address, because 127.0.0.1 inside this
  # container is the container itself.
  - job_name: nomad-services
    consul_sd_configs:
      - server: 192.168.86.199:8501
        scheme: https
        authorization:
          credentials_file: /secrets/consul_token
        tls_config:
          ca_file: /local/ca.crt
    relabel_configs:
      - source_labels: [__meta_consul_tags]
        regex: .*,metrics,.*
        action: keep
      - source_labels: [__meta_consul_service]
        target_label: service

  # The host's node_exporter. The backups job below keeps the backup script's
  # textfile metrics, so they are dropped here to avoid two copies.
  - job_name: node
    static_configs:
      - targets: ["192.168.86.199:9100"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: homelab_backup_.*
        action: drop

  - job_name: backups
    static_configs:
      - targets: ["192.168.86.199:9100"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: homelab_backup_.*
        action: keep

  # The control plane runs on the host, outside Nomad.
  - job_name: consul
    scheme: https
    metrics_path: /v1/agent/metrics
    params:
      format: [prometheus]
    authorization:
      credentials_file: /secrets/consul_token
    tls_config:
      ca_file: /local/ca.crt
    static_configs:
      - targets: ["192.168.86.199:8501"]

  - job_name: nomad
    scheme: https
    metrics_path: /v1/metrics
    params:
      format: [prometheus]
    tls_config:
      ca_file: /local/ca.crt
    static_configs:
      - targets: ["192.168.86.199:4646"]

  # Vault's listener allows unauthenticated metrics access.
  - job_name: vault
    scheme: https
    metrics_path: /v1/sys/metrics
    params:
      format: [prometheus]
    tls_config:
      ca_file: /local/ca.crt
    static_configs:
      - targets: ["192.168.86.199:8200"]

  # Each probe goes through the exporter, so its address is rendered from the
  # Consul catalog by the Nomad template.
  - job_name: blackbox
    scrape_interval: 60s
    scrape_timeout: 15s
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
%{ for key, service in public_services ~}
      - targets: ["${service.url}"]
        labels:
          service: "${key}"
          service_name: "${service.display_name}"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ range service "blackbox-exporter" }}{{ .Address }}:{{ .Port }}{{ end }}'

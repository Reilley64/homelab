global:
  scrape_interval: 15s

scrape_configs:
  - job_name: traefik
    static_configs:
      - targets: ["traefik:8080"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  # The host's node_exporter, for the backup script's textfile metrics only; the
  # node job above already covers the rest.
  - job_name: backups
    static_configs:
      - targets: ["192.168.86.199:9100"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: homelab_backup_.*
        action: keep

  - job_name: jellyfin-egress
    static_configs:
      - targets: ["observability-agent:9101"]

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # The control plane on the host. Static targets until phase 3 moves
  # discovery to consul_sd_configs.
  - job_name: consul
    scheme: https
    metrics_path: /v1/agent/metrics
    params:
      format: [prometheus]
    authorization:
      credentials: "${consul_metrics_token}"
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets: ["192.168.86.199:8501"]

  - job_name: nomad
    scheme: https
    metrics_path: /v1/metrics
    params:
      format: [prometheus]
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets: ["192.168.86.199:4646"]

  # Vault's listener allows unauthenticated metrics access.
  - job_name: vault
    scheme: https
    metrics_path: /v1/sys/metrics
    params:
      format: [prometheus]
    tls_config:
      ca_file: /etc/prometheus/ca.crt
    static_configs:
      - targets: ["192.168.86.199:8200"]

  - job_name: blackbox
    scrape_interval: 60s
    scrape_timeout: 15s
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
%{ for key, service in public_services ~}
      - targets: ["${service.url}"]
        labels:
          service: "${key}"
          service_name: "${service.display_name}"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-exporter
    static_configs:
      - targets: ["blackbox-exporter:9115"]

// Jellyfin writes the same stream to stdout and to /config/log, so tailing the
// files needs no docker socket — and picks up the FFmpeg session logs, which
// never reach stdout.

local.file_match "jellyfin" {
  path_targets = [{
    __path__     = "/logs/log_*.log",
    job          = "jellyfin",
    service_name = "jellyfin",
  }]
}

loki.source.file "jellyfin" {
  targets    = local.file_match.jellyfin.targets
  forward_to = [loki.process.jellyfin.receiver]
}

loki.process "jellyfin" {
  forward_to = [loki.write.default.receiver]

  // Without this, a .NET stack trace becomes one Loki entry per line.
  stage.multiline {
    firstline = "^\\[\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
  }

  // (?s) so the message group swallows the newlines of a joined stack trace.
  stage.regex {
    expression = "(?s)^\\[(?P<ts>[^\\]]+)\\] \\[(?P<level>\\w+)\\] \\[(?P<thread>\\d+)\\] (?P<message>.*)"
  }

  // Take Jellyfin's timestamp, not ingest time, so a replayed file lands on the
  // dashboard where it actually happened.
  stage.timestamp {
    source = "ts"
    format = "2006-01-02 15:04:05.000 -07:00"
  }

  // Serilog writes INF/WRN/ERR; Grafana only colours the full names, and shows
  // anything else as UNK.
  stage.template {
    source   = "level"
    template = "{{ if eq .Value \"INF\" }}info{{ else if eq .Value \"WRN\" }}warn{{ else if eq .Value \"ERR\" }}error{{ else if eq .Value \"DBG\" }}debug{{ else if eq .Value \"FTL\" }}critical{{ else if eq .Value \"TRC\" }}trace{{ else }}{{ .Value }}{{ end }}"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }

  // Metadata, not a label: thread ids are unbounded and would shard the stream.
  stage.structured_metadata {
    values = {
      thread = "thread",
    }
  }

  // Grafana renders the timestamp, level and thread in their own columns. A
  // line that didn't match the regex is left whole.
  stage.output {
    source = "message"
  }
}

local.file_match "jellyfin_ffmpeg" {
  path_targets = [{
    __path__     = "/logs/FFmpeg*.log",
    job          = "jellyfin-ffmpeg",
    service_name = "jellyfin",
  }]
}

// ponytail: no parsing — ffmpeg stderr carries no timestamps, so these take
// ingest time. Close enough; the file is written as the session runs.
loki.source.file "jellyfin_ffmpeg" {
  targets    = local.file_match.jellyfin_ffmpeg.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

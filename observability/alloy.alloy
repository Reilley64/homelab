// Jellyfin writes the same stream to stdout and to /config/log, so tailing the
// files needs no docker socket — and picks up the FFmpeg session logs, which
// never reach stdout.

// json_*.log is a second sink Jellyfin writes in CLEF. It exists because
// logging.default.json and logging.json are merged, not replaced: the stock
// outputTemplate can't be removed, only shadowed by a sink at a fresh index.
local.file_match "jellyfin" {
  path_targets = [{
    __path__     = "/logs/json_*.log",
    job          = "jellyfin",
    service_name = "jellyfin",
  }]
}

loki.source.file "jellyfin" {
  targets    = local.file_match.jellyfin.targets
  forward_to = [loki.process.jellyfin.receiver]
}

loki.process "jellyfin" {
  forward_to = [loki.write.default.receiver]

  // CLEF is one object per event with the exception inline, so nothing needs
  // stitching back together.
  stage.json {
    expressions = {
      ts        = "\"@t\"",
      level     = "\"@l\"",
      message   = "\"@m\"",
      exception = "\"@x\"",
      thread    = "ThreadId",
      logger    = "SourceContext",
    }
  }

  // Take Jellyfin's timestamp, not ingest time, so a replayed file lands on the
  // dashboard where it actually happened.
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  // CLEF leaves @l out entirely at Information. Serilog's Verbose is Grafana's
  // trace; the rest match once lowercased.
  stage.template {
    source   = "level"
    template = "{{ if eq .Value \"Verbose\" }}trace{{ else if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }

  // Metadata, not labels: thread ids are unbounded and loggers number in the
  // hundreds, either of which would shard the stream.
  stage.structured_metadata {
    values = {
      thread = "thread",
      logger = "logger",
    }
  }

  // @m alone drops the source context that made the text log scannable, so put
  // it back on the front. Grafana renders timestamp and level itself.
  stage.template {
    source   = "message"
    template = "{{ .logger }}: {{ .Value }}{{ if .exception }}\n{{ .exception }}{{ end }}"
  }

  stage.output {
    source = "message"
  }
}

local.file_match "jellyfin_ffmpeg" {
  path_targets = [{
    __path__     = "/logs/FFmpeg*.log",
    job          = "jellyfin-ffmpeg",
    service_name = "jellyfin",
  }]
}

// ponytail: no parsing — ffmpeg stderr carries no timestamps, so these take
// ingest time. Close enough; the file is written as the session runs.
loki.source.file "jellyfin_ffmpeg" {
  targets    = local.file_match.jellyfin_ffmpeg.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

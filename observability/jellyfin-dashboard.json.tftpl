{
  "uid": "jellyfin",
  "title": "Jellyfin",
  "tags": ["jellyfin", "traefik"],
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Public response accounting rate",
      "description": "Completed public-router response bytes accounted over time; not physical WAN-interface throughput and may include public-hostname hairpin traffic.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[$__rate_interval])) * 8",
          "legendFormat": "public"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Public egress",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Egress by user",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Egress" },
            "properties": [{ "id": "unit", "value": "decbytes" }]
          }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "user": 0, "Value": 1 },
            "renameByName": { "user": "User", "Value": "Egress" }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "Egress", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (user) (increase(jellyfin_user_egress_bytes_v2_total[$__range])))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Request latency",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 6, "x": 10, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[$__range])))",
          "legendFormat": "p99",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Status codes",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (increase(traefik_router_requests_total{router=\"jellyfin@docker\"}[$__range]))",
          "legendFormat": "{{code}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate, public vs LAN",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router) (rate(traefik_router_requests_total{router=~\"jellyfin(local)?@docker\"}[$__rate_interval]))",
          "legendFormat": "{{router}}"
        }
      ]
    }
  ]
}

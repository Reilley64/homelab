{
  "uid": "jellyfin",
  "title": "Jellyfin",
  "tags": ["jellyfin", "traefik"],
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Public upload rate",
      "description": "Bytes served to external clients via jellyfin.example.invalid. Excludes LAN traffic.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[5m])) * 8",
          "legendFormat": "public"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Public egress",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traefik_router_responses_bytes_total{router=\"jellyfin@docker\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate, public vs LAN",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router) (rate(traefik_router_requests_total{router=~\"jellyfin(local)?@docker\"}[5m]))",
          "legendFormat": "{{router}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Public request latency",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{router=\"jellyfin@docker\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Public status codes",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_router_requests_total{router=\"jellyfin@docker\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Public egress by user",
      "description": "Exact public response-body bytes attributed to the latest Jellyfin user observed for each client IP.",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "decbytes" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user) (increase(jellyfin_user_egress_bytes_total[$__range]))",
          "legendFormat": "{{user}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Upload rate by user",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user) (rate(jellyfin_user_egress_bytes_total[5m])) * 8",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "User/IP attribution",
      "datasource": { "type": "prometheus", "uid": "${datasource_uid}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Egress" },
            "properties": [{ "id": "unit", "value": "decbytes" }]
          }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "user": 0, "client_ip": 1, "Value": 2 },
            "renameByName": { "Value": "Egress" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user, client_ip) (increase(jellyfin_user_egress_bytes_total[$__range]))",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
